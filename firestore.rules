rules_version = '2';

// admin/ 配下は Firebase Auth（メール/パスワード）でログインしたユーザーのうち
// 管理者メールアドレスのみアクセス可能。
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kimijimasan@gmail.com';
    }

    match /apps/{appId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if resource.data.hidden == false || isAdmin();
        allow update, delete: if isAdmin();
        allow create: if false;
      }
    }

    // collectionGroup('reviews') クエリ用（管理画面のレビュー一覧）。
    // 上の /apps/{appId}/reviews ルールは個別サブコレクションへのアクセスのみに適用され、
    // 複数アプリをまとめて読むcollection groupクエリには別途ワイルドカードルールが必要。
    match /{path=**}/reviews/{reviewId} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if false;
    }

    // 来店者カウンター（visitors/total）。
    // 公開書き込みは「countを1だけ増やす」操作のみ許可し、
    // 任意値への改ざん・水増し・余計なフィールド追加・別ドキュメント作成を防ぐ。
    match /visitors/total {
      allow read: if true;
      // 初回作成: countフィールドのみ・値は1
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      // 更新: countを厳密に +1 する操作だけ許可（increment(1) 相当）
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    // visitors配下の total 以外は公開書き込み禁止（管理者のみ）。
    match /visitors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 開発者への問合せ。誰でも登録（create）できるが、email形式・文字数・
    // フィールド・作成時刻を厳格に検証。読み取り・更新・削除は管理者のみ。
    match /inquiries/{inquiryId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 1
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.createdAt == request.time;
    }

    // ウェイティングリスト（公開通知の宛先リストを兼ねる）。
    // 誰でも登録（create）できるが、email形式・フィールド・作成時刻を厳格に検証。
    // メールアドレスは個人情報のため、読み取り・削除は管理者のみ。
    match /waitlist/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && request.resource.data.createdAt == request.time;
    }

    // 一斉メール送信の監査ログ。書き込みは Cloud Function（Admin SDK＝ルール無視）のみ。
    // クライアントからの読み取りは管理者限定、書き込みは全面禁止。
    match /mailLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
